                <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 12px;">Đăng Nhập</h2>
                <input type="email" id="loginEmail" placeholder="Email..." style="width: 100%; padding: 10px; border: 1.5px solid var(--border); border-radius: 8px; margin-bottom: 10px;" />
                <input type="password" id="loginPassword" placeholder="Mật khẩu..." style="width: 100%; padding: 10px; border: 1.5px solid var(--border); border-radius: 8px; margin-bottom: 15px;" />
                <button class="btn btn-primary" style="width: 100%; justify-content: center; padding: 11px;" onclick="handleLoginSubmit()">Đăng Nhập</button>
            </div>
        </div>
    </div>

    <!-- CHATBOT WIDGET -->
    <button class="chat-widget-btn" id="btnToggleChat" onclick="toggleChatWindow()" title="Trò chuyện cùng AI">💬</button>
    <div class="chat-window" id="chatWindow">
        <div class="chat-header">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span>🤖</span>
                <div style="font-weight: 800; font-size: 0.96rem;">LifeSmart AI Assistant</div>
            </div>
            <button style="background: none; border: none; color: #fff; font-size: 1.3rem; cursor: pointer;" onclick="toggleChatWindow()">✕</button>
        </div>
        <div class="chat-body" id="chatBody"></div>
        <div class="chat-footer">
            <input type="text" class="chat-input" id="chatInput" placeholder="Nhập câu hỏi..." onkeypress="handleChatEnter(event)" />
            <button class="chat-send-btn" onclick="sendChatMessage()">Gửi</button>
        </div>
    </div>

    <div class="notification" id="toastBox"></div>

    <script src="~/js/script.js?v=@DateTime.Now.Ticks"></script>
</body>
</html>