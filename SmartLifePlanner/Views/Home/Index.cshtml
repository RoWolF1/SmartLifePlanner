@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LifeSmart - Hệ sinh thái Kế hoạch & Dinh dưỡng Chuẩn Y khoa</title>
    <!-- Nạp Chart.js để vẽ biểu đồ Thống kê & Biểu đồ tròn Macro -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
            :root {
                --etm-orange: #f2613b;
                --etm-orange-hover: #d94f2b;
                --etm-teal: #00a896;
                --etm-purple: #9067c6;
                --etm-yellow: #f4a261;
                --dark: #1e293b;
                --gray: #64748b;
                --light-bg: #f8fafc;
                --border: #e2e8f0;
                --primary: #10b981;
                --primary-dark: #059669;
                --primary-light: #ecfdf5;
                --glass-card: rgba(255, 255, 255, 0.94);
                --glass-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
            }

            body {
                background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%), url('/images/hero-bg.jpg') no-repeat center center fixed;
                background-size: cover;
                color: var(--dark);
                height: 100vh;
                overflow: hidden;
                display: flex;
            }

            .app-overlay {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: linear-gradient(135deg, rgba(248, 250, 252, 0.85) 0%, rgba(241, 245, 249, 0.75) 100%);
                backdrop-filter: blur(6px);
                z-index: 1;
                display: flex;
                width: 100%;
                height: 100%;
            }

            /* 1. SIDEBAR PHONG CÁCH EAT THIS MUCH */
            .sidebar {
                width: 260px;
                background: #ffffff;
                border-right: 1.5px solid var(--border);
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                z-index: 10;
            }

            .sidebar-brand {
                padding: 22px 20px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 1.45rem;
                font-weight: 800;
                color: var(--etm-orange);
                border-bottom: 1.5px solid var(--border);
            }

                .sidebar-brand span {
                    color: #10b981;
                }

            .btn-vip-banner {
                margin: 16px 14px;
                padding: 12px 16px;
                border-radius: 20px;
                background: linear-gradient(135deg, #f2613b 0%, #ea580c 100%);
                color: #fff;
                font-weight: 800;
                font-size: 0.9rem;
                border: none;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                cursor: pointer;
                box-shadow: 0 4px 14px rgba(242, 97, 59, 0.35);
                transition: all 0.2s;
            }

                .btn-vip-banner:hover {
                    transform: translateY(-1px);
                }

            .menu {
                list-style: none;
                padding: 0 10px;
                display: flex;
                flex-direction: column;
                gap: 4px;
                overflow-y: auto;
            }

            .menu-heading {
                font-size: 0.72rem;
                font-weight: 800;
                color: var(--gray);
                text-transform: uppercase;
                padding: 12px 14px 4px 14px;
            }

            .menu li a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 16px;
                border-radius: 10px;
                text-decoration: none;
                color: var(--gray);
                font-weight: 600;
                font-size: 0.92rem;
                transition: all 0.2s;
            }

                .menu li a:hover {
                    background: #f1f5f9;
                    color: var(--dark);
                }

                .menu li a.active {
                    background: #e0f2fe;
                    color: #0284c7;
                    font-weight: 700;
                }

            /* 2. MAIN WORKSPACE */
            .main-content {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                z-index: 5;
                position: relative;
            }

            .header {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(10px);
                padding: 16px 36px;
                border-bottom: 1.5px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 10;
            }

            .user-avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                font-size: 1.1rem;
                cursor: pointer;
            }

            .view-container {
                padding: 26px 36px;
                max-width: 1400px;
                margin: 0 auto;
                width: 100%;
            }

            /* THANH ĐIỀU HƯỚNG NGÀY & CÔNG CỤ */
            .date-navigator-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 22px;
                flex-wrap: wrap;
                gap: 14px;
            }

            .date-control {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 1.35rem;
                font-weight: 800;
                color: var(--dark);
            }

            .date-nav-btn {
                background: #fff;
                border: 1.5px solid var(--border);
                border-radius: 8px;
                width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-weight: 800;
                transition: all 0.2s;
            }

                .date-nav-btn:hover {
                    background: #f1f5f9;
                }

            /* BỐ CỤC 2 CỘT CHUẨN EAT THIS MUCH (60% MEALS - 40% MACRO WHEEL) */
            .etm-split-layout {
                display: grid;
                grid-template-columns: 1.4fr 1fr;
                gap: 26px;
            }

            /* CỘT TRÁI: DANH SÁCH BỮA ĂN THEO KHỐI */
            .meals-column {
                display: flex;
                flex-direction: column;
                gap: 20px;
            }

            .meal-group-card {
                background: #ffffff;
                border: 1.5px solid var(--border);
                border-radius: 14px;
                padding: 20px;
                box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
            }

            .meal-group-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 14px;
                border-bottom: 1px solid #f1f5f9;
                padding-bottom: 10px;
            }

            .meal-item-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 12px 14px;
                background: #f8fafc;
                border-radius: 10px;
                border: 1px solid var(--border);
                margin-bottom: 10px;
                gap: 12px;
            }

            .meal-item-img {
                width: 54px;
                height: 54px;
                border-radius: 8px;
                object-fit: cover;
                background: #e2e8f0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.6rem;
            }

            /* CỘT PHẢI: MACRO WHEEL & NUTRITION FACTS */
            .macro-column {
                background: #ffffff;
                border: 1.5px solid var(--border);
                border-radius: 16px;
                padding: 26px;
                box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
                height: fit-content;
            }

            .macro-pie-container {
                width: 220px;
                height: 220px;
                margin: 0 auto 20px auto;
                position: relative;
            }

            .btn {
                padding: 9px 18px;
                border-radius: 8px;
                border: none;
                font-weight: 700;
                font-size: 0.9rem;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                transition: all 0.2s;
            }

            .btn-primary {
                background: var(--etm-teal);
                color: #fff;
            }

                .btn-primary:hover {
                    background: #008f80;
                }

            .btn-orange {
                background: var(--etm-orange);
                color: #fff;
            }

                .btn-orange:hover {
                    background: var(--etm-orange-hover);
                }

            /* MODAL OVERLAY & BOX */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(15, 23, 42, 0.6);
                backdrop-filter: blur(4px);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 9999;
            }

            .modal-box {
                background: #ffffff;
                border-radius: 16px;
                width: 90%;
                max-width: 650px;
                padding: 28px;
                box-shadow: 0 20px 40px rgba(0,0,0,0.2);
                max-height: 88vh;
                overflow-y: auto;
            }

            .notification {
                position: fixed;
                bottom: 24px;
                right: 24px;
                background: var(--dark);
                color: #fff;
                padding: 12px 24px;
                border-radius: 10px;
                font-weight: 600;
                font-size: 0.92rem;
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 10000;
                box-shadow: 0 6px 20px rgba(0,0,0,0.2);
            }
    </style>
</head>

<body>
    <div class="app-overlay">
        <!-- 1. SIDEBAR PHONG CÁCH EAT THIS MUCH -->
        <aside class="sidebar">
            <div class="sidebar-brand">
                🥕 Life<span>Smart</span>
            </div>

            <!-- Nút gói tài khoản -->
            <button class="btn-vip-banner" id="btnSidebarVip" onclick="openPricingModal()">
                ⭐ <span id="sidebarVipText">Tính năng Cao cấp (VIP)</span>
            </button>

            <ul class="menu">
                <li>
                    <a href="javascript:void(0)" class="active" id="tab-nav-plan" onclick="switchEtmTab('plan')">
                        <span>📅</span><span>Kế hoạch (Plan)</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-track" onclick="switchEtmTab('track')">
                        <span>🍴</span><span>Theo dõi (Track)</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-statistics" onclick="switchEtmTab('statistics')">
                        <span>📊</span><span>Thống kê (Analytics)</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-water" onclick="switchEtmTab('water')">
                        <span>💧</span><span>Uống nước (Hydration)</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-sleep" onclick="switchEtmTab('sleep')">
                        <span>🌙</span><span>Giấc ngủ (Sleep AASM)</span>
                    </a>
                </li>

                <div class="menu-heading">Tài khoản & Phân quyền</div>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-profile" onclick="switchEtmTab('profile')">
                        <span>👤</span><span>Hồ sơ & Thể trạng</span>
                    </a>
                </li>
                <li id="menuAdminSection" style="display:none;">
                    <a href="javascript:void(0)" onclick="alert('Đang mở Bảng Quản trị Kho Dinh Dưỡng dành cho ADMIN!')">
                        <span>⚙️</span><span>Quản trị viên (Admin)</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" onclick="toggleUserVipRole()">
                        <span>🔄</span><span id="txtToggleRole">Chuyển sang gói VIP (Demo)</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- 2. MAIN WORKSPACE -->
        <main class="main-content">
            <header class="header">
                <div>
                    <h2 id="headerUserNameTitle" style="font-size:1.3rem; font-weight:800;">Xin chào, Dương Thu Hậu 👋</h2>
                    <small style="color:var(--gray);">Trợ lý Lập kế hoạch Thực đơn & Theo dõi Dinh dưỡng Tự động</small>
                </div>
                <div style="display:flex; align-items:center; gap:12px;">
                    <span id="badgeUserRole" style="padding:5px 12px; border-radius:12px; font-weight:800; font-size:0.75rem; background:#fee2e2; color:#ef4444;">GÓI FREE</span>
                    <div class="user-avatar" id="headerAvatar" onclick="switchEtmTab('profile')">H</div>
                </div>
            </header>

            <div class="view-container">

                <!-- ================= TAB 1: KẾ HOẠCH & THEO DÕI (PLAN & TRACK) ================= -->
                <div id="view-etm-planner">

                    <!-- THANH ĐIỀU HƯỚNG NGÀY & MÁY PHÁT ĐIỆN -->
                    <div class="date-navigator-bar">
                        <div class="date-control">
                            <button class="date-nav-btn" onclick="navigateDate(-1)">❮</button>
                            <span id="currentDateDisplay">Hôm nay</span>
                            <button class="date-nav-btn" onclick="navigateDate(1)">❯</button>
                        </div>
                        <div style="display:flex; gap:10px;">
                            <button class="btn btn-orange" onclick="openGeneratorDrawer()">
                                🪄 Cài đặt Máy phát điện AI
                            </button>
                            <button class="btn" style="background:#fff; border:1.5px solid var(--border);" onclick="openDetailedNutritionModal()">
                                📋 Chi tiết Dinh dưỡng
                            </button>
                        </div>
                    </div>

                    <!-- THÔNG BÁO KHÓA CHO TÀI KHOẢN FREE NẾU XEM TƯƠNG LAI -->
                    <div id="cardVipLockNotice" style="display:none; background:linear-gradient(135deg, #fff 0%, #fff7ed 100%); border:2px dashed #f97316; border-radius:16px; padding:36px; text-align:center; margin-bottom:24px;">
                        <span style="font-size:3rem;">🔒</span>
                        <h2 style="color:#c2410c; margin:10px 0 6px 0;">Tính năng Độc quyền dành cho Gói VIP</h2>
                        <p style="color:var(--gray); max-width:600px; margin:0 auto 20px auto;">
                            Tài khoản Free chỉ theo dõi thực đơn trong ngày hôm nay. Hãy nâng cấp lên Gói VIP để lên kế hoạch trước cho ngày mai, sinh thực đơn cả tuần và tạo danh sách đi chợ tự động!
                        </p>
                        <button class="btn btn-orange" style="padding:12px 28px; font-size:1rem;" onclick="openPricingModal()">⭐ Dùng thử Gói VIP Ngay</button>
                    </div>

                    <!-- BỐ CỤC CHÍNH 2 CỘT -->
                    <div class="etm-split-layout" id="etmMainContentArea">

                        <!-- CỘT TRÁI: DANH SÁCH BỮA ĂN -->
                        <div class="meals-column" id="mealsContainerList">
                            <!-- JS tự động render từng nhóm bữa ăn: Bữa sáng, Bữa trưa, Bữa tối -->
                        </div>

                        <!-- CỘT PHẢI: MACRO DOUGHNUT WHEEL & TỔNG NĂNG LƯỢNG -->
                        <div class="macro-column">
                            <div style="text-align:center; margin-bottom:14px;">
                                <h3 style="font-size:1.15rem; font-weight:800;">Tỷ lệ Đa lượng (Macro Ratio)</h3>
                                <small style="color:var(--gray);">Phân bổ năng lượng theo mục tiêu</small>
                            </div>

                            <div class="macro-pie-container">
                                <canvas id="canvasMacroWheel"></canvas>
                            </div>

                            <!-- BẢNG ĐỐI CHIẾU 2 CỘT NĂNG LƯỢNG -->
                            <div style="border-top:1.5px solid var(--border); padding-top:16px; display:flex; flex-direction:column; gap:12px;">
                                <div style="display:flex; justify-content:space-between; font-weight:800; font-size:1.05rem;">
                                    <span>Tổng Calo</span>
                                    <span><span id="trackedCaloVal" style="color:var(--etm-orange);">0</span> / <span id="targetCaloVal">2.150</span> kcal</span>
                                </div>
                                <div style="display:flex; justify-content:space-between; font-size:0.92rem;">
                                    <span style="color:#eab308; font-weight:700;">🟡 Carbs (Tinh bột)</span>
                                    <span><strong id="macroCarbsVal">0g</strong> / <span id="macroTargetCarbsVal">268g</span></span>
                                </div>
                                <div style="display:flex; justify-content:space-between; font-size:0.92rem;">
                                    <span style="color:#06b6d4; font-weight:700;">🔵 Fat (Chất béo)</span>
                                    <span><strong id="macroFatVal">0g</strong> / <span id="macroTargetFatVal">60g</span></span>
                                </div>
                                <div style="display:flex; justify-content:space-between; font-size:0.92rem;">
                                    <span style="color:#a855f7; font-weight:700;">🟣 Protein (Đạm)</span>
                                    <span><strong id="macroProteinVal">0g</strong> / <span id="macroTargetProteinVal">134g</span></span>
                                </div>
                            </div>

                            <button class="btn btn-primary" style="width:100%; margin-top:22px; justify-content:center;" onclick="openDetailedNutritionModal()">
                                Xem bảng Dinh dưỡng Toàn diện ➔
                            </button>
                        </div>
                    </div>

                </div>

                <!-- ================= TAB 2: THỐNG KÊ TRA CỨU N NGÀY ================= -->
                <div id="view-etm-statistics" style="display:none;">
                    <div style="background:#fff; border:1.5px solid var(--border); border-radius:14px; padding:20px; margin-bottom:20px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
                            <div>
                                <h3 style="font-size:1.25rem;">📈 Tra cứu Lịch sử & Khai phá Tiến trình</h3>
                                <p style="color:var(--gray); font-size:0.88rem; margin:0;" id="statInsightBox">Đang phân tích dữ liệu...</p>
                            </div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <span>Xem lại:</span>
                                <input type="number" id="inputCustomDays" min="1" max="365" value="7" style="width:65px; padding:6px; border:1px solid #cbd5e1; border-radius:6px; text-align:center; font-weight:800;" />
                                <span>ngày trước</span>
                                <button class="btn btn-primary" onclick="handleCustomDaysSearch()">Xem ngay</button>
                            </div>
                        </div>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;">
                        <div style="background:#fff; border:1.5px solid var(--border); border-radius:14px; padding:20px; height:320px;">
                            <h4 style="margin-bottom:10px;">🔥 Calo Nạp vs Đốt</h4>
                            <canvas id="caloChart"></canvas>
                        </div>
                        <div style="background:#fff; border:1.5px solid var(--border); border-radius:14px; padding:20px; height:320px;">
                            <h4 style="margin-bottom:10px;">💧 Nước uống (Lít)</h4>
                            <canvas id="waterStepsChart"></canvas>
                        </div>
                    </div>

                    <div style="background:#fff; border:1.5px solid var(--border); border-radius:14px; padding:20px;">
                        <h4 style="margin-bottom:12px;">📜 Bảng Nhật ký Chi tiết Từng Ngày</h4>
                        <table style="width:100%; border-collapse:collapse; text-align:left; font-size:0.92rem;">
                            <thead>
                                <tr style="border-bottom:2px solid var(--border); color:var(--gray);">
                                    <th style="padding:10px;">Ngày</th>
                                    <th style="padding:10px;">Calo Nạp</th>
                                    <th style="padding:10px;">Calo Đốt</th>
                                    <th style="padding:10px;">Cân Bằng</th>
                                    <th style="padding:10px;">Nước</th>
                                </tr>
                            </thead>
                            <tbody id="statHistoryTableBody"></tbody>
                        </table>
                    </div>
                </div>

                <!-- ================= TAB 3: UỐNG NƯỚC ================= -->
                <div id="view-etm-water" style="display:none;">
                    <div style="background:#fff; border:1.5px solid var(--border); border-radius:14px; padding:24px;">
                        <h2>💧 Theo dõi Nước Uống Thông minh</h2>
                        <p style="color:var(--gray); margin-bottom:16px;">Tự động tính bù lượng nước hao hụt theo hoạt động thể chất.</p>
                        <div style="display:flex; gap:10px;">
                            <button class="btn btn-primary" onclick="alert('Đã thêm 250ml nước!')">+ 250ml</button>
                            <button class="btn btn-primary" onclick="alert('Đã thêm 500ml nước!')">+ 500ml</button>
                        </div>
                    </div>
                </div>

                <!-- ================= TAB 4: GIẤC NGỦ ================= -->
                <div id="view-etm-sleep" style="display:none;">
                    <div style="background:#fff; border:1.5px solid var(--border); border-radius:14px; padding:24px;">
                        <h2>🌙 Chu kỳ Giấc ngủ 90 Phút (AASM)</h2>
                        <p style="color:var(--gray); margin-bottom:16px;">Tính toán giờ thức dậy tối ưu giữa các pha ngủ nông.</p>
                        <div style="font-size:1.4rem; font-weight:800; color:#7c3aed; margin-top:10px;">Giờ ngủ khuyên dùng tối nay: 22:45 (5 chu kỳ - 7.5 tiếng)</div>
                    </div>
                </div>

                <!-- ================= TAB 5: HỒ SƠ ================= -->
                <div id="view-etm-profile" style="display:none;">
                    <div style="background:#fff; border:1.5px solid var(--border); border-radius:14px; padding:24px;">
                        <h2>👤 Hồ sơ Cá nhân & Năng lượng Nền (BMR)</h2>
                        <p style="color:#059669; font-weight:700; margin:10px 0;">Áp dụng công thức y học Mifflin-St Jeor (1990) & WHO Standards.</p>
                        <div style="line-height:2.2;">
                            <div>Họ và tên: <strong>Dương Thu Hậu</strong></div>
                            <div>Thể trạng: <strong>Cao 173 cm • Nặng 60 kg • 20 tuổi</strong></div>
                            <div>Năng lượng nền tự nhiên (BMR): <strong>1.586 kcal</strong></div>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- MODAL 1: BẢNG CHI TIẾT NUTRITION FACTS TOÀN DIỆN (EAT THIS MUCH STYLE) -->
    <div class="modal-overlay" id="modalDetailedNutrition">
        <div class="modal-box">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; border-bottom:1.5px solid var(--border); padding-bottom:12px;">
                <h3 style="font-size:1.3rem; font-weight:800;">Detailed Nutrition Information</h3>
                <button style="background:none; border:none; font-size:1.5rem; cursor:pointer;" onclick="closeDetailedNutritionModal()">✕</button>
            </div>
            <div style="font-size:0.92rem; line-height:2;">
                <div style="display:flex; justify-content:space-between; font-weight:800; font-size:1.05rem; border-bottom:1px solid #f1f5f9; padding:4px 0;">
                    <span>Calories</span>
                    <span><strong id="dnCaloriesVal">0</strong> / 2.150 kcal</span>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid #f1f5f9; padding:4px 0;">
                    <span>Carbohydrates</span>
                    <span><strong id="dnCarbsVal">0g</strong> / 268g</span>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid #f1f5f9; padding:4px 0;">
                    <span>Dietary Fiber (Chất xơ)</span>
                    <span><strong id="dnFiberVal">0g</strong> / 25g</span>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid #f1f5f9; padding:4px 0;">
                    <span>Total Fat (Chất béo)</span>
                    <span><strong id="dnFatVal">0g</strong> / 60g</span>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid #f1f5f9; padding:4px 0;">
                    <span>Protein (Đạm)</span>
                    <span><strong id="dnProteinVal">0g</strong> / 134g</span>
                </div>
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid #f1f5f9; padding:4px 0;">
                    <span>Sodium (Natri)</span>
                    <span><strong id="dnSodiumVal">0mg</strong> / 2.300mg</span>
                </div>
                <div style="display:flex; justify-content:space-between; padding:4px 0;">
                    <span>Cholesterol</span>
                    <span><strong id="dnCholesterolVal">0mg</strong> / 300mg</span>
                </div>
            </div>
            <button class="btn btn-primary" style="width:100%; margin-top:20px; justify-content:center;" onclick="closeDetailedNutritionModal()">Đóng cửa sổ</button>
        </div>
    </div>

    <!-- MODAL 2: BẢNG GIÁ NÂNG CẤP GÓI VIP (EAT THIS MUCH STYLE) -->
    <div class="modal-overlay" id="modalPricingVip">
        <div class="modal-box" style="text-align:center; max-width:620px;">
            <span style="font-size:2.8rem;">⭐</span>
            <h2 style="font-size:1.5rem; margin:10px 0 6px 0; color:#c2410c;">Mở khóa Gói LifeSmart VIP</h2>
            <p style="color:var(--gray); font-size:0.92rem; margin-bottom:24px;">Lên kế hoạch trước cho nhiều tuần, tự động gom hàng tạp hóa và phân tích Macro AI chuẩn Viện Dinh Dưỡng.</p>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:24px;">
                <div style="border:2px solid #fdba74; border-radius:12px; padding:20px; background:#fff7ed; cursor:pointer;">
                    <div style="font-weight:800; font-size:1.1rem; color:#ea580c;">Hàng tháng</div>
                    <div style="font-size:1.8rem; font-weight:800; margin:8px 0;">99.000 đ</div>
                    <small style="color:var(--gray);">Thanh toán từng tháng</small>
                </div>
                <div style="border:2px solid #f97316; border-radius:12px; padding:20px; background:#ffedd5; cursor:pointer; position:relative;">
                    <span style="position:absolute; top:-12px; right:12px; background:#ea580c; color:#fff; font-size:0.75rem; font-weight:800; padding:2px 8px; border-radius:10px;">TIẾT KIỆM 50%</span>
                    <div style="font-weight:800; font-size:1.1rem; color:#ea580c;">Trọn năm (VIP)</div>
                    <div style="font-size:1.8rem; font-weight:800; margin:8px 0;">49.000 đ</div>
                    <small style="color:var(--gray);">Tính mỗi tháng (588k/năm)</small>
                </div>
            </div>

            <button class="btn btn-orange" style="width:100%; padding:12px; font-size:1.05rem; justify-content:center;" onclick="activateVipDemo()">
                Kích hoạt Dùng thử VIP Miễn phí (Chế độ Demo)
            </button>
            <button style="background:none; border:none; color:var(--gray); margin-top:14px; cursor:pointer; font-weight:600;" onclick="closePricingModal()">Bỏ qua lúc này</button>
        </div>
    </div>

    <!-- MODAL 3: CÀI ĐẶT MÁY PHÁT ĐIỆN THỰC ĐƠN TOÀN DIỆN (GENERATOR SETTINGS - EAT THIS MUCH STYLE) -->
    <div class="modal-overlay" id="modalGenerator">
        <div class="modal-box">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; border-bottom:1.5px solid var(--border); padding-bottom:12px;">
                <h3 style="font-size:1.35rem; font-weight:800; color:var(--dark);">🪄 Generator Settings</h3>
                <button style="background:none; border:none; font-size:1.5rem; cursor:pointer;" onclick="closeGeneratorDrawer()">✕</button>
            </div>

            <!-- TỰ ĐỘNG LÊN KẾ HOẠCH TUẦN -->
            <div style="background:#f8fafc; border:1.5px solid var(--border); border-radius:12px; padding:14px 18px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center;">
                <div>
                    <div style="font-weight:800; font-size:0.95rem; color:var(--dark);">
                        🔒 Enable automatic weekly planner
                    </div>
                    <small style="color:var(--gray);">A premium account is required to generate weeks in advance.</small>
                </div>
                <button class="btn btn-orange" style="padding:6px 14px; font-size:0.8rem;" onclick="openPricingModal()">⭐ Start Trial</button>
            </div>

            <div style="display:flex; flex-direction:column; gap:16px; max-height:58vh; overflow-y:auto; padding-right:6px;">
                <!-- 1. GIỚI HẠN NGÂN SÁCH MỖI NGÀY -->
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">
                        Daily price limit <span title="Giới hạn ngân sách chi tiêu ăn uống mỗi ngày" style="cursor:help;">ⓘ</span>
                    </label>
                    <select id="genDailyPriceLimit" style="width:220px; padding:8px 12px; border-radius:8px; border:1px solid var(--border); font-weight:600;">
                        <option value="No limit" selected>No limit</option>
                        <option value="Low">Low (Tiết kiệm)</option>
                        <option value="Medium">Medium (Trung bình)</option>
                        <option value="High">High (Cao cấp)</option>
                    </select>
                </div>

                <!-- 2. CÁCH TÍNH CARBS -->
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">
                        Target carbs as <span title="Chọn tính theo tổng Carbs hay Net Carbs" style="cursor:help;">ⓘ</span>
                    </label>
                    <select id="genTargetCarbsAs" style="width:220px; padding:8px 12px; border-radius:8px; border:1px solid var(--border); font-weight:600;">
                        <option value="Total carbs" selected>Total carbs</option>
                        <option value="Net carbs">Net carbs</option>
                    </select>
                </div>

                <!-- 3. TRỌNG TÂM SINH THỰC ĐƠN -->
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">
                        Generator focus <span title="Thuật toán AI sẽ ưu tiên tối ưu hóa tiêu chí này" style="cursor:help;">ⓘ</span>
                    </label>
                    <select id="genSelectFocus" style="width:220px; padding:8px 12px; border-radius:8px; border:1px solid var(--border); font-weight:600;">
                        <option value="Balanced" selected>Balanced (Cân bằng)</option>
                        <option value="Variety">Variety (Đa dạng)</option>
                        <option value="Macros">Macros (Khớp Macro)</option>
                        <option value="Groceries">Groceries (Đi chợ)</option>
                    </select>
                </div>

                <!-- 4. CHO PHÉP NỬA KHẨU PHẦN -->
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">
                        Allow half servings <span title="Cho phép chia nửa khẩu phần để cân chỉnh năng lượng vừa vặn" style="cursor:help;">ⓘ</span>
                    </label>
                    <input type="checkbox" id="genAllowHalfServings" checked style="width:20px; height:20px; cursor:pointer; accent-color:var(--primary);" />
                </div>

                <div style="border-top:1px solid var(--border); margin:4px 0;"></div>

                <!-- 5. TÙY CHỈNH Y TẾ & CHUYỂN HÓA -->
                <h4 style="font-size:0.95rem; font-weight:800; color:var(--gray); text-transform:uppercase;">Medical</h4>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">
                        Adjust my meals for GLP-1 <span title="Tối ưu khẩu phần giàu đạm, giảm thể tích cho người dùng liệu trình chuyển hóa" style="cursor:help;">ⓘ</span>
                    </label>
                    <input type="checkbox" id="genAdjustGlp1" style="width:20px; height:20px; cursor:pointer; accent-color:var(--primary);" />
                </div>

                <div style="border-top:1px solid var(--border); margin:4px 0;"></div>

                <!-- 6. THỜI GIAN & ĐƠN VỊ ĐO LƯỜNG -->
                <h4 style="font-size:0.95rem; font-weight:800; color:var(--gray); text-transform:uppercase;">Time and Units</h4>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">First day of week</label>
                    <select id="genFirstDayOfWeek" style="width:220px; padding:8px 12px; border-radius:8px; border:1px solid var(--border); font-weight:600;">
                        <option value="Sunday">Sunday</option>
                        <option value="Monday" selected>Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>
                    </select>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">Timezone</label>
                    <select id="genTimezone" style="width:220px; padding:8px 12px; border-radius:8px; border:1px solid var(--border); font-weight:600;">
                        <option value="GMT+7" selected>(GMT +7:00) Bangkok, Hanoi, Jakarta</option>
                    </select>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">Preferred units</label>
                    <div style="display:flex; gap:6px;">
                        <span class="badge" style="background:#f1f5f9; color:var(--gray); padding:6px 12px; cursor:pointer;">U.S. Standard</span>
                        <span class="badge" style="background:var(--primary); color:#fff; padding:6px 12px; cursor:pointer;">Metric</span>
                    </div>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <label style="font-weight:700; font-size:0.9rem; color:var(--dark);">Preferred unit of energy</label>
                    <div style="display:flex; gap:6px;">
                        <span class="badge" style="background:var(--primary); color:#fff; padding:6px 12px; cursor:pointer;">Calories</span>
                        <span class="badge" style="background:#f1f5f9; color:var(--gray); padding:6px 12px; cursor:pointer;">Kilojoules</span>
                    </div>
                </div>
            </div>

            <div style="margin-top:22px; display:flex; gap:12px;">
                <button class="btn btn-orange" style="flex:1; padding:12px; font-size:1rem; justify-content:center;" onclick="executeMealGenerator()">
                    ⚡ Bắt đầu Sinh Thực đơn 1-Click
                </button>
                <button class="btn" style="background:#f1f5f9; color:var(--gray); padding:12px 18px;" onclick="closeGeneratorDrawer()">Đóng</button>
            </div>
        </div>
    </div>

    <div class="notification" id="toastBox"></div>

    <!-- Nhúng script.js với tham số ép làm mới cache -->
    <script src="~/js/script.js?v=@DateTime.Now.Ticks"></script>
</body>
</html>