<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LifeSmart - Quản lý lối sống & Lịch trình thông minh</title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Nạp Chart.js để vẽ biểu đồ Thống kê -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .timeline-container {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-top: 15px;
        }

        .btn-random {
            background-color: #f5a623;
            color: #ffffff;
            border: none;
            padding: 9px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }

            .btn-random:hover {
                background-color: #d98218;
            }

        .spin-box {
            background: #fdf8f0;
            border: 2px dashed #f5a623;
            border-radius: 12px;
            padding: 24px;
            text-align: center;
            margin-bottom: 24px;
        }

        .food-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }

        .food-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .water-btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin: 15px 0;
        }

        .water-preset-btn {
            background: #eff6ff;
            color: #1d4ed8;
            border: 1px solid #bfdbfe;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
        }

            .water-preset-btn:hover {
                background: #dbeafe;
            }

        .sleep-cycle-card {
            background: #f8fafc;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 15px;
            text-align: center;
            flex: 1;
            min-width: 130px;
        }
    </style>
</head>

<body>
    <div class="app">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="logo">Life<span>Smart</span></div>
            <ul class="menu">
                <li>
                    <a href="javascript:void(0)" class="active" id="tab-nav-dashboard" onclick="switchTab('dashboard')">
                        <span>🏠</span><span>Tổng quan</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-schedule" onclick="switchTab('schedule')">
                        <span>📅</span><span>Kế hoạch & Lịch trình</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-meals" onclick="switchTab('meals')">
                        <span>🥗</span><span>Thực đơn & Random</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-activity" onclick="switchTab('activity')">
                        <span>🏃</span><span>Hoạt động</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-water" onclick="switchTab('water')">
                        <span>💧</span><span>Uống nước</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-sleep" onclick="switchTab('sleep')">
                        <span>😴</span><span>Giấc ngủ</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-statistics" onclick="switchTab('statistics')">
                        <span>📊</span><span>Thống kê</span>
                    </a>
                </li>
                <li>
                    <a href="javascript:void(0)" id="tab-nav-profile" onclick="switchTab('profile')">
                        <span>👤</span><span>Cá nhân</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- MAIN -->
        <main class="main-content">
            <header class="header">
                <div>
                    <h1 id="page-title">Xin chào 👋</h1>
                    <p id="page-subtitle">Cùng theo dõi kế hoạch sinh hoạt và duy trì lối sống khoa học hôm nay.</p>
                </div>
                <div class="user" style="display:flex; align-items:center; gap:12px;">
                    <div style="text-align:right;">
                        <strong id="headerUserName">Dương Thu Hậu</strong><br>
                        <small id="headerUserRole" style="color:var(--gray);">Thành viên</small>
                    </div>
                    <div class="user-avatar" id="headerUserAvatar" style="cursor:pointer;" title="Đăng xuất" onclick="handleLogout()">H</div>
                </div>
            </header>

            <!-- ================= VIEW 1: SẢNH TỔNG QUAN ================= -->
            <div id="view-dashboard">
                <section class="dashboard-cards">
                    <div class="card">
                        <div class="card-header"><span class="card-title">Chỉ số BMI</span><div class="card-icon">⚖️</div></div>
                        <div class="card-value" id="dash-bmi">22.8</div>
                        <div class="card-unit" id="dash-bmi-unit">Bình thường</div>
                    </div>
                    <div class="card">
                        <div class="card-header"><span class="card-title">Calo hôm nay</span><div class="card-icon">🔥</div></div>
                        <div class="card-value" id="dash-calo">0</div>
                        <div class="card-unit" id="dash-calo-unit">/ 2,000 kcal</div>
                        <div class="progress-box"><div class="progress"><div class="progress-bar calorie-progress" id="dash-calo-progress" style="width: 0%;"></div></div></div>
                    </div>
                    <div class="card">
                        <div class="card-header"><span class="card-title">Nước uống</span><div class="card-icon">💧</div></div>
                        <div class="card-value water-value" id="dash-water">0.0 L</div>
                        <div class="card-unit" id="dash-water-target">/ 2.5 L</div>
                        <div class="progress-box"><div class="progress"><div class="progress-bar water-progress" id="dash-water-progress" style="width: 0%;"></div></div></div>
                    </div>
                    <div class="card">
                        <div class="card-header"><span class="card-title">Vận động</span><div class="card-icon">🏃</div></div>
                        <div class="card-value" id="dash-steps">0</div>
                        <div class="card-unit">bước hôm nay</div>
                    </div>
                </section>

                <section class="recommendation" style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                        <h2>🤖 Gợi ý & Trợ lý thông minh</h2>
                        <p id="dashRecommendationText">Dinh dưỡng và vận động đóng góp 100% vào năng lượng của bạn. Hãy ghi nhận đủ hôm nay nhé!</p>
                    </div>
                    <button class="btn-random" onclick="switchTab('meals')">🎲 Tới Vòng quay món ăn</button>
                </section>

                <section class="content-grid">
                    <!-- THỰC ĐƠN ĐỘNG TRÊN SẢNH -->
                    <div class="section">
                        <div class="section-title">
                            <h2>🍱 Thực đơn hôm nay</h2>
                            <button class="btn-random" style="font-size:0.8rem;" onclick="switchTab('meals')">🎲 Chọn món</button>
                        </div>
                        <div class="meal-list">
                            <div class="meal-card">
                                <div class="meal-info">
                                    <div class="meal-image">🍳</div>
                                    <div>
                                        <div class="meal-name" id="overview-meal-breakfast">Bữa sáng - Chưa chọn món</div>
                                        <div class="meal-type" id="overview-tag-breakfast">Bấm đổi món để chọn</div>
                                    </div>
                                </div>
                                <div class="meal-calories" id="overview-calo-breakfast">0 kcal</div>
                            </div>
                            <div class="meal-card">
                                <div class="meal-info">
                                    <div class="meal-image">🍗</div>
                                    <div>
                                        <div class="meal-name" id="overview-meal-lunch">Bữa trưa - Chưa chọn món</div>
                                        <div class="meal-type" id="overview-tag-lunch">Bấm đổi món để chọn</div>
                                    </div>
                                </div>
                                <div class="meal-calories" id="overview-calo-lunch">0 kcal</div>
                            </div>
                            <div class="meal-card">
                                <div class="meal-info">
                                    <div class="meal-image">🐟</div>
                                    <div>
                                        <div class="meal-name" id="overview-meal-dinner">Bữa tối - Chưa chọn món</div>
                                        <div class="meal-type" id="overview-tag-dinner">Bấm đổi món để chọn</div>
                                    </div>
                                </div>
                                <div class="meal-calories" id="overview-calo-dinner">0 kcal</div>
                            </div>
                        </div>
                    </div>

                    <!-- LỊCH TRÌNH ĐỘNG TRÊN SẢNH -->
                    <div class="section">
                        <div class="section-title">
                            <h2>📅 Lịch trình hôm nay</h2>
                            <span class="badge badge-blue">Xem nhanh</span>
                        </div>
                        <div class="timeline-container" id="overviewTimelineList"></div>
                    </div>
                </section>

                <!-- THẺ GIẤC NGỦ ĐÊM QUA & THEO DÕI NƯỚC TẠI SẢNH -->
                <section class="content-grid" style="margin-top: 20px;">
                    <div class="section">
                        <div class="section-title"><h2>💧 Theo dõi lượng nước</h2><span class="badge badge-blue" id="waterGoalPercentBadge">0% mục tiêu</span></div>
                        <p>Đã uống <strong class="water-value">0.0 L</strong> / <span id="dashWaterGoalSpan">2.5 L</span> hôm nay.</p>
                        <div class="water-container">
                            <div class="water-glass"></div><div class="water-glass"></div>
                            <div class="water-glass"></div><div class="water-glass"></div>
                            <div class="water-glass"></div><div class="water-glass"></div>
                            <div class="water-glass"></div><div class="water-glass"></div>
                        </div>
                        <br>
                        <button class="btn btn-primary" onclick="switchTab('water')">Vào quản lý nước chi tiết 💧</button>
                    </div>

                    <div class="section">
                        <div class="section-title"><h2>😴 Giấc ngủ gần nhất</h2><span class="badge badge-blue" id="dashSleepStatusBadge">Chưa ghi nhận</span></div>
                        <div id="dashSleepDetailBox" style="padding: 10px 0;">
                            <p style="color:var(--gray); font-size:0.95rem;">Bạn chưa ghi nhận giấc ngủ đêm qua. Hãy bấm vào để tính chu kỳ và ghi nhận điểm phục hồi!</p>
                        </div>
                        <button class="btn btn-primary" style="background:#8b5cf6;" onclick="switchTab('sleep')">Tính chu kỳ giấc ngủ 🌙</button>
                    </div>
                </section>
            </div>

            <!-- ================= VIEW 2: TRANG QUẢN LÝ LỊCH TRÌNH ================= -->
            <div id="view-schedule" style="display: none;">
                <div class="section" style="margin-bottom: 24px;">
                    <div class="section-title"><h2>➕ Thiết lập mốc thời gian mới</h2></div>
                    <p style="color: var(--gray); font-size: 0.9rem; margin-bottom: 16px;">
                        Tự do thiết lập mốc giờ và công việc. Dữ liệu sẽ lưu trực tiếp vào cơ sở dữ liệu SQL Server.
                    </p>
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <input type="text" id="inputTimeSlot" placeholder="Khung giờ (VD: 07:30 - 08:30)" style="padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; width: 220px; font-size: 0.9rem;" />
                        <input type="text" id="inputTitle" placeholder="Nội dung công việc / bữa ăn..." style="flex: 1; min-width: 240px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; font-size: 0.9rem;" />
                        <select id="inputCategory" style="padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px; font-size: 0.9rem;">
                            <option value="Task">💻 Việc làm / Học tập</option>
                            <option value="Meal">🍲 Ăn uống</option>
                            <option value="Rest">😴 Nghỉ ngơi</option>
                        </select>
                        <button class="btn btn-primary" onclick="handleCreateTimeline()">Lưu vào Database</button>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <h2>📋 Danh sách lịch trình chi tiết trong ngày</h2>
                        <span class="badge badge-blue" id="timelineCountBadge">0 công việc</span>
                    </div>
                    <div id="manageTimelineList" style="display: flex; flex-direction: column; gap: 12px;"></div>
                </div>
            </div>

            <!-- ================= VIEW 3: TRANG THỰC ĐƠN & RANDOM MÓN ĂN ================= -->
            <div id="view-meals" style="display: none;">
                <div class="spin-box">
                    <h2 style="color: #d98218; margin-bottom: 8px;">🎲 Vòng quay ngẫu nhiên: Hôm nay ăn gì?</h2>
                    <p style="color: var(--gray); font-size: 0.95rem; margin-bottom: 20px;">
                        Hệ thống sẽ lấy món ăn từ kho SQL Server dựa trên bữa bạn chọn.
                    </p>
                    <div style="display: flex; justify-content: center; gap: 15px; margin-bottom: 20px;">
                        <select id="wheelMealType" style="padding: 10px 16px; border-radius: 8px; border: 1px solid var(--border); font-size: 1rem; font-weight: 600;">
                            <option value="Breakfast">🍳 Bữa sáng</option>
                            <option value="Lunch" selected>🍗 Bữa trưa</option>
                            <option value="Dinner">🐟 Bữa tối</option>
                        </select>
                        <button class="btn-random" style="font-size: 1rem; padding: 10px 24px;" onclick="handleSpinFood()">Quay món ngay!</button>
                    </div>

                    <div id="spinResultCard" style="display:none; background:#fff; border-radius:12px; padding:20px; max-width:460px; margin:0 auto; box-shadow:var(--card-shadow); border: 1px solid #fed7aa;">
                        <div style="font-size:1.5rem; font-weight:800; color:var(--dark);" id="spinFoodName">Cơm gà</div>
                        <div style="margin: 8px 0; color: var(--gray);" id="spinFoodMeta">🔥 0 kcal</div>
                        <div style="font-size:0.85rem; color:#d98218; font-weight:600; margin-bottom:15px;" id="spinFoodTag">Gợi ý</div>
                        <button class="btn btn-primary" id="btnApplySpinFood" style="width:100%;">
                            ✅ Áp dụng món này vào Thực đơn hôm nay
                        </button>
                    </div>
                </div>

                <div class="section" style="margin-bottom: 24px;">
                    <div class="section-title"><h2>➕ Thêm món mới vào kho dữ liệu</h2></div>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <input type="text" id="newMealName" placeholder="Tên món ăn (VD: Bún riêu cua)" style="flex:2; min-width:180px; padding:9px 12px; border:1px solid var(--border); border-radius:8px;" />
                        <select id="newMealType" style="flex:1; min-width:120px; padding:9px 12px; border:1px solid var(--border); border-radius:8px;">
                            <option value="Breakfast">Bữa sáng</option>
                            <option value="Lunch">Bữa trưa</option>
                            <option value="Dinner">Bữa tối</option>
                        </select>
                        <input type="number" id="newMealCalo" placeholder="Calo (kcal)" style="width:120px; padding:9px 12px; border:1px solid var(--border); border-radius:8px;" />
                        <input type="number" id="newMealPrice" placeholder="Giá (VNĐ)" style="width:130px; padding:9px 12px; border:1px solid var(--border); border-radius:8px;" />
                        <button class="btn btn-primary" onclick="handleCreateMeal()">+ Lưu món vào DB</button>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title">
                        <h2>📚 Kho thực đơn trong Database</h2>
                        <span class="badge badge-blue" id="totalMealsBadge">0 món</span>
                    </div>
                    <div class="food-grid" id="mealGridList"></div>
                </div>
            </div>

            <!-- ================= VIEW 4: HOẠT ĐỘNG & TẬP LUYỆN ================= -->
            <div id="view-activity" style="display: none;">
                <div class="section" style="margin-bottom: 24px; text-align: center; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border: 1px solid #bfdbfe;">
                    <h2 style="color: #1d4ed8; margin-bottom: 6px;">⏱️ Đồng hồ tập luyện trực tiếp</h2>
                    <p style="color: var(--gray); font-size: 0.9rem;">Bấm bắt đầu khi bạn tập luyện; thời gian sẽ được đếm và lưu chính xác từng giây</p>

                    <div style="display: flex; justify-content: center; gap: 12px; margin: 12px 0;">
                        <select id="timerSportType" style="padding: 8px 14px; border-radius: 8px; border: 1px solid var(--border); font-weight: 600;">
                            <option value="Running">🏃 Chạy bộ (~2.5 bước/giây)</option>
                            <option value="Walking" selected>🚶 Đi bộ (~1.8 bước/giây)</option>
                            <option value="Cycling">🚴 Đạp xe (~1.5 nhịp/giây)</option>
                            <option value="Gym">🏋️ Tập Gym / Kháng lực (~1.0 nhịp/giây)</option>
                        </select>
                    </div>

                    <div style="font-size: 3.2rem; font-weight: 800; color: #1e40af; margin: 10px 0;" id="stopwatchDisplay">00:00</div>

                    <div style="display: flex; justify-content: center; gap: 10px;">
                        <button class="btn btn-primary" id="btnTimerStart" onclick="startWorkoutTimer()">Bắt đầu tập</button>
                        <button class="btn" style="background: #ef4444; color: #fff; display: none;" id="btnTimerStop" onclick="stopWorkoutTimer()">Kết thúc & Lưu</button>
                    </div>
                </div>

                <div class="section" style="margin-bottom: 24px;">
                    <div class="section-title"><h2>➕ Ghi nhận bài tập thủ công</h2></div>
                    <p style="color: var(--gray); font-size: 0.9rem; margin-bottom: 16px;">
                        Nhập thời gian tập (chọn nhập theo Phút hoặc Giây). Hệ thống sẽ tự quy đổi ra bước chân và calo tiêu hao chuẩn xác.
                    </p>
                    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                        <select id="inputActType" style="padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px;">
                            <option value="Running">🏃 Chạy bộ</option>
                            <option value="Walking" selected>🚶 Đi bộ</option>
                            <option value="Cycling">🚴 Đạp xe</option>
                            <option value="Gym">🏋️ Tập Gym / Kháng lực</option>
                        </select>
                        <input type="number" id="inputActValue" placeholder="Số lượng..." style="width: 140px; padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px;" />
                        <select id="inputActUnit" style="padding: 10px 14px; border: 1px solid var(--border); border-radius: 8px;">
                            <option value="seconds">Giây</option>
                            <option value="minutes" selected>Phút</option>
                        </select>
                        <button class="btn btn-primary" onclick="handleLogActivityManual()">Lưu vận động</button>
                    </div>
                </div>

                <div class="section">
                    <div class="section-title" style="display: flex; justify-content: space-between; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <h2>📋 Nhật ký vận động hôm nay</h2>
                            <span class="badge badge-blue" id="activityCountBadge">0 buổi tập</span>
                        </div>
                        <button class="btn" style="background: #fee2e2; color: #dc2626; font-size: 0.8rem; padding: 6px 12px;" onclick="handleResetAllActivities()">
                            🔄 Reset hôm nay về 0
                        </button>
                    </div>
                    <div id="todayActivityList" style="display: flex; flex-direction: column; gap: 10px; margin-top: 14px;"></div>
                </div>
            </div>

            <!-- ================= VIEW 5: UỐNG NƯỚC (HYDRATION TRACKER CHI TIẾT) ================= -->
            <div id="view-water" style="display: none;">
                <!-- Thẻ mục tiêu cá nhân hóa -->
                <div class="section" style="background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%); border: 1px solid #7dd3fc; margin-bottom: 24px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <h2 style="color: #0369a1; margin-bottom: 6px;">💧 Mục tiêu nước cá nhân hóa hôm nay</h2>
                            <p style="color: #0f172a; font-size: 0.95rem;" id="waterFormulaDesc">
                                Tính theo cân nặng của bạn và số phút tập luyện trong ngày.
                            </p>
                        </div>
                        <div style="text-align:right;">
                            <div style="font-size: 2.2rem; font-weight: 800; color: #0284c7;" id="waterTargetLitersDisplay">2.5 L</div>
                            <small style="color: #0369a1; font-weight: 600;">Mục tiêu hôm nay</small>
                        </div>
                    </div>
                </div>

                <!-- Thêm nhanh cốc nước -->
                <div class="section" style="margin-bottom: 24px;">
                    <div class="section-title"><h2>⚡ Thêm nhanh cốc nước</h2></div>
                    <p style="color:var(--gray); font-size:0.9rem;">Chọn loại đồ uống và dung tích cốc:</p>

                    <div style="margin: 12px 0; display:flex; gap:12px; align-items:center;">
                        <label style="font-weight:600;">Loại nước:</label>
                        <select id="waterTypeSelect" style="padding: 8px 14px; border:1px solid var(--border); border-radius:8px;">
                            <option value="Water">💧 Nước lọc (100% bù nước)</option>
                            <option value="Tea">🍵 Trà xanh (85% bù nước)</option>
                            <option value="Coffee">☕ Cà phê (80% bù nước)</option>
                            <option value="Milk">🥛 Sữa hạt (+50 kcal / 100ml)</option>
                            <option value="Juice">🍊 Nước ép (+45 kcal / 100ml)</option>
                        </select>
                    </div>

                    <div class="water-btn-group">
                        <button class="water-preset-btn" onclick="handleQuickWater(150)">+ 150ml (Tách trà)</button>
                        <button class="water-preset-btn" onclick="handleQuickWater(250)">+ 250ml (Cốc chuẩn)</button>
