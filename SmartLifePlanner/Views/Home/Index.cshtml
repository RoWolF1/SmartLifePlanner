@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LifeSmart - Hệ sinh thái Kế hoạch & Dinh dưỡng Chuẩn Y khoa</title>
    <!-- Font chữ hiện đại & FontAwesome & Chart.js -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
            :root {
                --etm-orange: #f2613b;
                --etm-orange-hover: #d94f2b;
                --etm-teal: #00a896;
                --etm-purple: #9067c6;
                --etm-yellow: #f4a261;
                --dark: #0f172a;
                --gray: #64748b;
                --light-bg: #f8fafc;
                --border: #e2e8f0;
                --primary: #10b981;
                --primary-dark: #059669;
                --primary-light: #ecfdf5;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
                font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
            }

            body {
                background: #f8fafc;
                color: var(--dark);
                height: 100vh;
                overflow: hidden;
                display: flex;
            }

            .app-overlay {
                display: flex;
                width: 100%;
                height: 100%;
            }

            /* 1. SIDEBAR */
            .sidebar {
                width: 260px;
                background: #ffffff;
                border-right: 1.5px solid var(--border);
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                z-index: 10;
            }

            .sidebar-brand {
                padding: 20px;
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 1.4rem;
                font-weight: 800;
                color: var(--etm-orange);
                border-bottom: 1.5px solid var(--border);
            }

                .sidebar-brand span {
                    color: var(--primary);
                }

            .btn-vip-banner {
                margin: 14px 14px 8px 14px;
                padding: 11px 16px;
                border-radius: 12px;
                background: linear-gradient(135deg, #f2613b 0%, #ea580c 100%);
                color: #fff;
                font-weight: 800;
                font-size: 0.88rem;
                border: none;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                cursor: pointer;
                box-shadow: 0 4px 14px rgba(242, 97, 59, 0.3);
                transition: all 0.2s;
            }

                .btn-vip-banner:hover {
                    transform: translateY(-1px);
                }

            .menu {
                list-style: none;
                padding: 0 10px;
                display: flex;
                flex-direction: column;
                gap: 3px;
                overflow-y: auto;
                flex: 1;
            }

            .menu-heading {
                font-size: 0.72rem;
                font-weight: 800;
                color: #94a3b8;
                letter-spacing: 0.5px;
                text-transform: uppercase;
                padding: 12px 14px 4px 14px;
            }

            .menu li a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 14px;
                border-radius: 10px;
                text-decoration: none;
                color: var(--gray);
                font-weight: 600;
                font-size: 0.9rem;
                transition: all 0.2s;
            }

                .menu li a:hover {
                    background: #f1f5f9;
                    color: var(--dark);
                }

                .menu li a.active {
                    background: #e0f2fe;
                    color: #0284c7;
                    font-weight: 700;
                }

            /* 2. MAIN WORKSPACE */
            .main-content {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                position: relative;
            }

            .header {
                background: rgba(255, 255, 255, 0.95);
                backdrop-filter: blur(10px);
                padding: 14px 32px;
                border-bottom: 1.5px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
                position: sticky;
                top: 0;
                z-index: 10;
            }

            .user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: #fff;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 800;
                font-size: 1rem;
                cursor: pointer;
            }

            .btn-auth-header {
                background: #dcfce7;
                color: #15803d;
                border: 1px solid #86efac;
                padding: 7px 14px;
                border-radius: 8px;
                font-weight: 700;
                font-size: 0.82rem;
                display: flex;
                align-items: center;
                gap: 6px;
                cursor: pointer;
                transition: all 0.2s;
            }

            .view-container {
                padding: 24px 32px;
                max-width: 1400px;
                margin: 0 auto;
                width: 100%;
            }

            /* HERO CARD & PROOF SHOWCASE (LANDING) */
            .hero-banner {
                background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
                border-radius: 18px;
                padding: 32px 36px;
                color: #ffffff;
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 24px;
                box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.2);
            }

            .hero-banner-content {
                max-width: 65%;
            }

                .hero-banner-content h1 {
                    font-size: 1.65rem;
                    font-weight: 800;
                    margin: 12px 0 8px 0;
                }

                .hero-banner-content p {
                    font-size: 0.92rem;
                    color: #94a3b8;
                    line-height: 1.6;
                }

            .badge-pill {
                background: rgba(16, 185, 129, 0.18);
                color: #34d399;
                border: 1px solid rgba(16, 185, 129, 0.35);
                padding: 5px 12px;
                border-radius: 20px;
                font-size: 0.78rem;
                font-weight: 700;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

            .proof-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
                margin-bottom: 24px;
            }

            .proof-box {
                background: #ffffff;
                border: 1.5px solid var(--border);
                border-radius: 14px;
                padding: 20px;
                display: flex;
                flex-direction: column;
                box-shadow: 0 4px 12px rgba(15, 23, 42, 0.03);
            }

            .proof-box-icon {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.25rem;
                margin-bottom: 12px;
            }

            .bg-orange {
                background: #ffedd5;
                color: #ea580c;
            }

            .bg-purple {
                background: #f3e8ff;
                color: #9333ea;
            }

            .proof-box h4 {
                font-size: 0.98rem;
                font-weight: 800;
                color: var(--dark);
                margin-bottom: 6px;
            }

            .proof-box p {
                font-size: 0.84rem;
                color: var(--gray);
                line-height: 1.5;
                flex: 1;
            }

            .proof-badge {
                margin-top: 12px;
                font-size: 0.78rem;
                font-weight: 700;
                color: var(--primary);
                display: flex;
                align-items: center;
                gap: 5px;
            }

            /* ETM LAYOUT */
            .date-navigator-bar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 20px;
                flex-wrap: wrap;
                gap: 12px;
            }

            .date-control {
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 1.3rem;
                font-weight: 800;
                color: var(--dark);
            }

            .date-nav-btn {
                background: #fff;
                border: 1.5px solid var(--border);
                border-radius: 8px;
                width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                font-weight: 800;
                transition: all 0.2s;
            }

                .date-nav-btn:hover {
                    background: #f1f5f9;
                }

            .etm-split-layout {
                display: grid;
                grid-template-columns: 1.4fr 1fr;
                gap: 24px;
            }

            .meals-column {
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .meal-group-card {
                background: #ffffff;
                border: 1.5px solid var(--border);
                border-radius: 14px;
                padding: 18px;
                box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
            }

            .meal-group-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 12px;
                border-bottom: 1px solid #f1f5f9;
                padding-bottom: 8px;
            }

            .meal-item-row {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 11px 14px;
                background: #f8fafc;
                border-radius: 10px;
                border: 1px solid var(--border);
                margin-bottom: 8px;
                gap: 12px;
            }

            .meal-item-img {
                width: 44px;
                height: 44px;
                border-radius: 8px;
                background: #e2e8f0;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.4rem;
            }

            .macro-column {
                background: #ffffff;
                border: 1.5px solid var(--border);
                border-radius: 16px;
                padding: 24px;
                box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
                height: fit-content;
            }

            .macro-pie-container {
                width: 210px;
                height: 210px;
                margin: 0 auto 16px auto;
                position: relative;
            }

            .btn {
                padding: 9px 16px;
                border-radius: 8px;
                border: none;
                font-weight: 700;
                font-size: 0.88rem;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: all 0.2s;
            }

            .btn-primary {
                background: var(--etm-teal);
                color: #fff;
            }

                .btn-primary:hover {
                    background: #008f80;
                }

            .btn-orange {
                background: var(--etm-orange);
                color: #fff;
            }

                .btn-orange:hover {
                    background: var(--etm-orange-hover);
                }

            .water-glass {
                transition: opacity 0.3s, transform 0.2s;
            }

                .water-glass.active {
                    opacity: 1 !important;
                    transform: scale(1.15);
                }

            /* MODALS */
            .modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(15, 23, 42, 0.6);
                backdrop-filter: blur(4px);
                display: none;
                align-items: center;
                justify-content: center;
                z-index: 9999;
            }

            .modal-box {
                background: #ffffff;
                border-radius: 16px;
                width: 90%;
                max-width: 650px;
                padding: 26px;
                box-shadow: 0 20px 40px rgba(0,0,0,0.2);
                max-height: 88vh;
                overflow-y: auto;
            }

            .notification {
                position: fixed;
                bottom: 24px;
                right: 24px;
                background: var(--dark);
                color: #fff;
                padding: 12px 22px;
                border-radius: 10px;
                font-weight: 600;
                font-size: 0.9rem;
                opacity: 0;
                transition: opacity 0.3s ease;
                z-index: 10000;
                box-shadow: 0 6px 20px rgba(0,0,0,0.2);
            }

            /* FLOATING CHATBOT WIDGET */
            .chat-widget-btn {
                position: fixed;
                bottom: 26px;
                right: 26px;
                width: 60px;
                height: 60px;
                border-radius: 50%;
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: #fff;
                border: none;
                box-shadow: 0 8px 24px rgba(16, 185, 129, 0.45);
                font-size: 1.7rem;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                z-index: 9998;
                transition: all 0.3s;
            }

                .chat-widget-btn:hover {
                    transform: scale(1.08) translateY(-3px);
                }

            .chat-window {
                position: fixed;
                bottom: 98px;
                right: 26px;
                width: 390px;
                height: 530px;
                background: #ffffff;
                border-radius: 18px;
                box-shadow: 0 20px 45px rgba(15, 23, 42, 0.18);
                border: 1.5px solid var(--border);
                display: none;
                flex-direction: column;
                z-index: 9998;
                overflow: hidden;
                animation: fadeInWidget 0.25s ease-out;
            }

            @@keyframes fadeInWidget {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .chat-header {
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: #fff;
                padding: 14px 18px;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .chat-body {
                flex: 1;
                padding: 16px;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 10px;
                background: #f8fafc;
            }

            .chat-msg {
                max-width: 85%;
                padding: 10px 14px;
                border-radius: 13px;
                font-size: 0.88rem;
                line-height: 1.46;
                word-break: break-word;
            }

            .chat-msg-ai {
                background: #ffffff;
                color: var(--dark);
                border: 1px solid var(--border);
                align-self: flex-start;
                border-bottom-left-radius: 2px;
            }

            .chat-msg-user {
                background: #10b981;
                color: #ffffff;
                align-self: flex-end;
                border-bottom-right-radius: 2px;
            }

            .chat-footer {
                padding: 11px 13px;
                background: #ffffff;
                border-top: 1.5px solid var(--border);
                display: flex;
                gap: 8px;
                align-items: center;
            }

            .chat-input {
                flex: 1;
                padding: 10px 13px;
                border: 1.5px solid var(--border);
                border-radius: 9px;
                outline: none;
                font-size: 0.88rem;
            }

                .chat-input:focus {
                    border-color: #10b981;
                }

            .chat-send-btn {
                background: #10b981;
                color: #fff;
                border: none;
                border-radius: 9px;
                padding: 0 15px;
                height: 40px;
                font-weight: 700;
                cursor: pointer;
            }

                .chat-send-btn:hover {
                    background: #059669;
                }

            
            /* =========================================================
                               LIFESMART — PREMIUM HEALTH PLATFORM
                               A complete visual system layered over the existing markup.
                               Existing IDs, inline handlers, tab logic and script.js retained.
                               ========================================================= */
            :root {
                --ls-forest: #073b32;
                --ls-forest-2: #0b5142;
                --ls-green: #0e9b68;
                --ls-green-2: #19b77a;
                --ls-mint: #e7f7ef;
                --ls-ink: #172b3b;
                --ls-muted: #718295;
                --ls-line: #e5ebf1;
                --ls-canvas: #f3f6fa;
                --ls-card: #ffffff;
                --ls-gold: #f2b84b;
                --ls-shadow: 0 8px 26px rgba(24, 47, 68, .055);
                --ls-shadow-hover: 0 16px 34px rgba(24, 47, 68, .10);
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                width: 100%;
                min-height: 100%;
            }

            body {
                display: block;
                height: 100vh;
                overflow: hidden;
                background: #eaf0f5;
                color: var(--ls-ink);
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-size: 13px;
                letter-spacing: -.12px;
                -webkit-font-smoothing: antialiased;
            }

            button, input, select, textarea {
                font-family: inherit;
            }

            .app-overlay {
                width: 100%;
                height: 100vh;
                display: flex;
                gap: 0;
                padding: 9px;
                background: radial-gradient(ellipse at 75% 0%, rgba(218,231,248,.75), transparent 36%), #eaf0f5;
            }

            /* LEFT NAVIGATION */
            .sidebar {
                width: 224px;
                min-width: 224px;
                height: 100%;
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
                overflow: hidden;
                color: #eaf8f1;
                background: linear-gradient(165deg, #073b32 0%, #084b3c 52%, #06362f 100%);
                border: 1px solid rgba(255,255,255,.08);
                border-radius: 17px;
                box-shadow: 0 10px 28px rgba(7,45,39,.16);
                z-index: 20;
            }

            .sidebar-brand {
                min-height: 66px;
                padding: 17px 19px;
                display: flex;
                align-items: center;
                gap: 9px;
                color: #f7fffa;
                font-size: 1.13rem;
                font-weight: 800;
                letter-spacing: -.65px;
                border-bottom: 1px solid rgba(255,255,255,.10);
            }

                .sidebar-brand::first-letter {
                    color: #7be0a8;
                }

                .sidebar-brand span {
                    color: #9ce8b8;
                }

            .btn-vip-banner {
                margin: 13px 12px 11px;
                min-height: 39px;
                padding: 9px 10px;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 7px;
                border: 1px solid rgba(255,214,132,.35);
                border-radius: 10px;
                color: #4a3511;
                background: linear-gradient(105deg,#f9d477,#eeb447);
                box-shadow: 0 5px 14px rgba(0,0,0,.13);
                font-size: .73rem;
                font-weight: 800;
                cursor: pointer;
                transition: .2s ease;
            }

                .btn-vip-banner:hover {
                    transform: translateY(-1px);
                    filter: brightness(1.04);
                }

            .menu {
                flex: 1;
                min-height: 0;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 3px;
                padding: 0 10px 12px;
                list-style: none;
            }

            .menu-heading {
                padding: 13px 10px 6px;
                color: #8bb9a7;
                font-size: .62rem;
                font-weight: 800;
                letter-spacing: 1.1px;
            }

            .menu li a {
                min-height: 35px;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                border: 1px solid transparent;
                border-radius: 9px;
                color: #d2e5dc;
                text-decoration: none;
                font-size: .73rem;
                font-weight: 600;
                transition: background .18s ease, color .18s ease, transform .18s ease;
            }

                .menu li a span:first-child {
                    width: 18px;
                    text-align: center;
                    opacity: .92;
                    font-size: .82rem;
                }

                .menu li a:hover {
                    color: #fff;
                    background: rgba(255,255,255,.085);
                    transform: translateX(2px);
                }

                .menu li a.active {
                    color: #fff;
                    background: linear-gradient(100deg,#19a96f,#087b55);
                    border-color: rgba(152,255,205,.16);
                    box-shadow: 0 5px 14px rgba(0,0,0,.13);
                    font-weight: 800;
                }

            /* MAIN CANVAS + TOP BAR */
            .main-content {
                flex: 1;
                min-width: 0;
                height: 100%;
                margin-left: 9px;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                overflow-x: hidden;
                position: relative;
                background: var(--ls-canvas);
                border: 1px solid #e0e7ef;
                border-radius: 17px;
                box-shadow: 0 8px 26px rgba(24,47,68,.055);
                scrollbar-width: thin;
                scrollbar-color: #cbd6e1 transparent;
            }

            .header {
                min-height: 68px;
                padding: 12px 25px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                position: sticky;
                top: 0;
                z-index: 15;
                background: rgba(250,252,255,.94);
                border: 0;
                border-bottom: 1px solid #e5ebf2;
                backdrop-filter: blur(16px);
            }

                .header h2 {
                    color: #172e40;
                    font-size: 1rem !important;
                    font-weight: 800;
                    letter-spacing: -.45px;
                    line-height: 1.35;
                }

                .header small {
                    display: block;
                    margin-top: 3px;
                    color: #8492a1 !important;
                    font-size: .67rem;
                    font-weight: 500;
                }

                .header > div:last-child {
                    gap: 10px !important;
                }

            #badgeUserRole {
                padding: 6px 9px !important;
                color: #16815b !important;
                background: #e9f7ef !important;
                border: 1px solid #d3eddd;
                border-radius: 20px !important;
                font-size: .59rem !important;
                letter-spacing: .35px;
            }

            .user-avatar {
                width: 35px;
                height: 35px;
                border: 2px solid #fff;
                box-shadow: 0 0 0 1px #dce5ed, 0 3px 8px rgba(22,42,61,.08);
                background: linear-gradient(135deg,#0c7659,#27bd80);
                font-size: .85rem;
            }

            .btn-auth-header {
                padding: 8px 11px;
                border: 1px solid #cfe9da;
                border-radius: 9px;
                color: #08784f;
                background: #edf8f1;
                font-size: .69rem;
                font-weight: 700;
            }

            .view-container {
                width: 100%;
                max-width: 1540px;
                margin: 0 auto;
                padding: 20px 24px 32px;
            }

            /* LANDING HERO — cinematic landscape, restrained overlays */
            .hero-banner {
                position: relative;
                isolation: isolate;
                min-height: 218px;
                margin-bottom: 20px;
                padding: 25px 28px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 22px;
                overflow: hidden;
                color: #fff;
                border: 1px solid rgba(255,255,255,.52);
                border-radius: 15px;
                background: linear-gradient(90deg,rgba(5,32,43,.96) 0%,rgba(7,40,50,.89) 43%,rgba(7,39,49,.43) 72%,rgba(7,39,49,.18) 100%), url("https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1900&q=90") center 54% / cover no-repeat;
                box-shadow: 0 12px 28px rgba(18,47,63,.15);
            }

                .hero-banner::before {
                    content: "";
                    position: absolute;
                    z-index: -1;
                    inset: 0;
                    background: linear-gradient(0deg,rgba(2,24,32,.22),transparent 58%);
                    pointer-events: none;
                }

            .hero-banner-content {
                max-width: 67%;
                position: relative;
                z-index: 1;
            }

